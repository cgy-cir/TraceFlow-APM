# Copy to /opt/traceflow/.env.production ON THE SERVER; chmod 600.
# These are placeholders, never use them as real credentials.
APM_HOST=apm.revengedog.online
DEMO_HOST=demo.revengedog.online
ACME_EMAIL=CHANGE_ME@example.com
TRACEFLOW_DB_PASSWORD=CHANGE_ME_generate_48_hex_characters
TRACEFLOW_MYSQL_ROOT_PASSWORD=CHANGE_ME_generate_different_48_hex_characters
# First deployment only. Remove both entries after the administrator exists.
TRACEFLOW_BOOTSTRAP_ADMIN_EMAIL=CHANGE_ME@example.com
TRACEFLOW_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_generate_a_long_random_password
