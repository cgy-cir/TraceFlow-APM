{
	email {$ACME_EMAIL}
	admin off
}

(private_files) {
	@private path_regexp private (?i)(\.map$|(^|/)traceflow-release\.json$|(^|/)\.)
	respond @private 404
	@internal path /actuator /actuator/*
	respond @internal 404
}

{$APM_HOST} {
	encode gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
	}
	request_body {
		max_size 11MB
	}
	route {
		import private_files
		@api path /api /api/*
		handle @api {
			reverse_proxy server:18080
		}
		@assets path /assets/*
		handle @assets {
			root * /srv/console
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
		handle {
			root * /srv/console
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}
	}
}

{$DEMO_HOST} {
	encode gzip
	header X-Content-Type-Options nosniff
	route {
		import private_files
		root * /srv/demo/current
		file_server
	}
}

http://:8081 {
	respond /health "OK" 200
	respond 404
}
